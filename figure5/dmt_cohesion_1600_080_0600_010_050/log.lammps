LAMMPS (19 Nov 2024 - Development)
atom_style   sphere
boundary     p p f
newton       off
comm_modify vel yes
units        si

###############################################
# Geometry-related parameters
###############################################
variable        d1 equal 0.004
variable        d2 equal ${d1}/7
variable        d2 equal 0.004/7
variable        r1 equal ${d1}/2
variable        r1 equal 0.004/2
variable        r2 equal ${d2}/2
variable        r2 equal 0.000571428571428571/2
variable        boxx equal ${d1}*16
variable        boxx equal 0.004*16
variable        boxy equal ${d1}*16
variable        boxy equal 0.004*16
variable        boxz equal ${d1}*32
variable        boxz equal 0.004*32
variable        boxz2 equal ${d1}*34
variable        boxz2 equal 0.004*34
variable        boxz3 equal ${d1}*32.2
variable        boxz3 equal 0.004*32.2
variable        boxz4 equal ${d1}*32.8
variable        boxz4 equal 0.004*32.8
variable        z2    equal ${d1}*32.7
variable        z2    equal 0.004*32.7
variable        reff equal ${r1}*${r2}/(${r1}+${r2})
variable        reff equal 0.002*${r2}/(${r1}+${r2})
variable        reff equal 0.002*0.000285714285714286/(${r1}+${r2})
variable        reff equal 0.002*0.000285714285714286/(0.002+${r2})
variable        reff equal 0.002*0.000285714285714286/(0.002+0.000285714285714286)

###############################################
# Particle-related parameters
###############################################
variable        dens1 equal 2500
#############
# processors      1 1 1
region          boxreg block 0 ${boxx} 0 ${boxy} 0 ${boxz}
region          boxreg block 0 0.064 0 ${boxy} 0 ${boxz}
region          boxreg block 0 0.064 0 0.064 0 ${boxz}
region          boxreg block 0 0.064 0 0.064 0 0.128
region          boxreg2 block 0 ${boxx} 0 ${boxy} 0 ${boxz2}
region          boxreg2 block 0 0.064 0 ${boxy} 0 ${boxz2}
region          boxreg2 block 0 0.064 0 0.064 0 ${boxz2}
region          boxreg2 block 0 0.064 0 0.064 0 0.136
region          top block 0 ${boxx} 0 ${boxy} ${boxz3} ${boxz4}
region          top block 0 0.064 0 ${boxy} ${boxz3} ${boxz4}
region          top block 0 0.064 0 0.064 ${boxz3} ${boxz4}
region          top block 0 0.064 0 0.064 0.1288 ${boxz4}
region          top block 0 0.064 0 0.064 0.1288 0.1312
create_box      2 boxreg2
Created orthogonal box = (0 0 0) to (0.064 0.064 0.136)
  1 by 1 by 1 MPI processor grid
change_box      all boundary p p f
Changing box ...

read_data      newstart.in add append
Reading data file ...
  orthogonal box = (0 0 0) to (0.064 0.064 0.136)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  19387 atoms
  reading velocities ...
  19387 velocities
  read_data CPU = 0.139 seconds

variable	    YoungsM equal 10000000
variable        poisson equal 0.17
variable	    rescoef equal 0.8
variable	    mu      equal 0.10
variable	    cohe equal 1/3*${dens1}*9.8*${r2}*${r2}*${r2}/${reff}*16.0
variable	    cohe equal 1/3*2500*9.8*${r2}*${r2}*${r2}/${reff}*16.0
variable	    cohe equal 1/3*2500*9.8*0.000285714285714286*${r2}*${r2}/${reff}*16.0
variable	    cohe equal 1/3*2500*9.8*0.000285714285714286*0.000285714285714286*${r2}/${reff}*16.0
variable	    cohe equal 1/3*2500*9.8*0.000285714285714286*0.000285714285714286*0.000285714285714286/${reff}*16.0
variable	    cohe equal 1/3*2500*9.8*0.000285714285714286*0.000285714285714286*0.000285714285714286/0.00025*16.0

variable        m1 equal 4/3*${dens1}*3.14*${r1}*${r1}*${r1}
variable        m1 equal 4/3*2500*3.14*${r1}*${r1}*${r1}
variable        m1 equal 4/3*2500*3.14*0.002*${r1}*${r1}
variable        m1 equal 4/3*2500*3.14*0.002*0.002*${r1}
variable        m1 equal 4/3*2500*3.14*0.002*0.002*0.002
variable        m2 equal 4/3*${dens1}*3.14*${r2}*${r2}*${r2}
variable        m2 equal 4/3*2500*3.14*${r2}*${r2}*${r2}
variable        m2 equal 4/3*2500*3.14*0.000285714285714286*${r2}*${r2}
variable        m2 equal 4/3*2500*3.14*0.000285714285714286*0.000285714285714286*${r2}
variable        m2 equal 4/3*2500*3.14*0.000285714285714286*0.000285714285714286*0.000285714285714286
variable        Eeff equal ${YoungsM}/(2*(1-${poisson}*${poisson}))
variable        Eeff equal 10000000/(2*(1-${poisson}*${poisson}))
variable        Eeff equal 10000000/(2*(1-0.17*${poisson}))
variable        Eeff equal 10000000/(2*(1-0.17*0.17))
variable        meff equal ${m1}*${m2}/(${m1}+${m2})
variable        meff equal 8.37333333333333e-05*${m2}/(${m1}+${m2})
variable        meff equal 8.37333333333333e-05*2.44120505344996e-07/(${m1}+${m2})
variable        meff equal 8.37333333333333e-05*2.44120505344996e-07/(8.37333333333333e-05+${m2})
variable        meff equal 8.37333333333333e-05*2.44120505344996e-07/(8.37333333333333e-05+2.44120505344996e-07)
variable        mur equal 0.5
variable        etar equal 0.5
variable        kn equal 4/3*${Eeff}
variable        kn equal 4/3*5148800.32952322
variable        kr equal 2.25*${kn}*${mur}*${mur}*${reff}*${reff}
variable        kr equal 2.25*6865067.10603096*${mur}*${mur}*${reff}*${reff}
variable        kr equal 2.25*6865067.10603096*0.5*${mur}*${reff}*${reff}
variable        kr equal 2.25*6865067.10603096*0.5*0.5*${reff}*${reff}
variable        kr equal 2.25*6865067.10603096*0.5*0.5*0.00025*${reff}
variable        kr equal 2.25*6865067.10603096*0.5*0.5*0.00025*0.00025
variable        Ir equal 1/(1/(7/5*${m1}*${r1}*${r1})+1/(7/5*${m2}*${r2}*${r2}))
variable        Ir equal 1/(1/(7/5*8.37333333333333e-05*${r1}*${r1})+1/(7/5*${m2}*${r2}*${r2}))
variable        Ir equal 1/(1/(7/5*8.37333333333333e-05*0.002*${r1})+1/(7/5*${m2}*${r2}*${r2}))
variable        Ir equal 1/(1/(7/5*8.37333333333333e-05*0.002*0.002)+1/(7/5*${m2}*${r2}*${r2}))
variable        Ir equal 1/(1/(7/5*8.37333333333333e-05*0.002*0.002)+1/(7/5*2.44120505344996e-07*${r2}*${r2}))
variable        Ir equal 1/(1/(7/5*8.37333333333333e-05*0.002*0.002)+1/(7/5*2.44120505344996e-07*0.000285714285714286*${r2}))
variable        Ir equal 1/(1/(7/5*8.37333333333333e-05*0.002*0.002)+1/(7/5*2.44120505344996e-07*0.000285714285714286*0.000285714285714286))
variable        Cr equal 2*sqrt(${kr}*${Ir})
variable        Cr equal 2*sqrt(0.241350015446401*${Ir})
variable        Cr equal 2*sqrt(0.241350015446401*2.7897826431858e-14)
variable        gammar equal ${etar}*${Cr}/${reff}
variable        gammar equal 0.5*${Cr}/${reff}
variable        gammar equal 0.5*1.64111435802018e-07/${reff}
variable        gammar equal 0.5*1.64111435802018e-07/0.00025

pair_style      granular
pair_coeff      * * dmt ${YoungsM} ${rescoef} ${poisson} ${cohe} tangential mindlin  NULL 0 ${mu} damping coeff_restitution rolling sds ${kr} ${gammar} ${mur} twisting marshall
pair_coeff      * * dmt 10000000 ${rescoef} ${poisson} ${cohe} tangential mindlin  NULL 0 ${mu} damping coeff_restitution rolling sds ${kr} ${gammar} ${mur} twisting marshall
pair_coeff      * * dmt 10000000 0.8 ${poisson} ${cohe} tangential mindlin  NULL 0 ${mu} damping coeff_restitution rolling sds ${kr} ${gammar} ${mur} twisting marshall
pair_coeff      * * dmt 10000000 0.8 0.17 ${cohe} tangential mindlin  NULL 0 ${mu} damping coeff_restitution rolling sds ${kr} ${gammar} ${mur} twisting marshall
pair_coeff      * * dmt 10000000 0.8 0.17 0.0121904761904762 tangential mindlin  NULL 0 ${mu} damping coeff_restitution rolling sds ${kr} ${gammar} ${mur} twisting marshall
pair_coeff      * * dmt 10000000 0.8 0.17 0.0121904761904762 tangential mindlin  NULL 0 0.1 damping coeff_restitution rolling sds ${kr} ${gammar} ${mur} twisting marshall
pair_coeff      * * dmt 10000000 0.8 0.17 0.0121904761904762 tangential mindlin  NULL 0 0.1 damping coeff_restitution rolling sds 0.241350015446401 ${gammar} ${mur} twisting marshall
pair_coeff      * * dmt 10000000 0.8 0.17 0.0121904761904762 tangential mindlin  NULL 0 0.1 damping coeff_restitution rolling sds 0.241350015446401 0.000328222871604036 ${mur} twisting marshall
pair_coeff      * * dmt 10000000 0.8 0.17 0.0121904761904762 tangential mindlin  NULL 0 0.1 damping coeff_restitution rolling sds 0.241350015446401 0.000328222871604036 0.5 twisting marshall

pair_coeff      2 2 hertz/material 1 1 0.4 tangential mindlin  NULL 1 0 damping viscoelastic
pair_coeff      1 1 hertz/material 1 1 0.4 tangential mindlin  NULL 1 0 damping viscoelastic

neigh_modify    exclude type 1 1
neigh_modify    exclude type 2 2
#fix             zwall all wall/gran hooke  1e7 NULL 50.0 NULL 0.5 0 zplane 0 ${boxz2}
group           fines type 2
10000 atoms in group fines
group           bed type 1
9387 atoms in group bed
velocity        bed set  0 0 0

###############################################
# run the sim
###############################################
thermo_style    custom step atoms ke
thermo_modify   lost warn
thermo          10000
fix             4 bed freeze
timestep        1e-5
fix             1 fines nve/sphere
fix             gg fines gravity 9.8 vector 0 0 -1

dump            out1 all custom 1000000 pour_*.txt id radius type x y z vx vy vz omegax omegay omegaz fx fy fz mass
dump_modify     out1 format line "%d %f %d %.10f %.10f %.10f %e %e %e %e %e %e %e %e %e %e"
run             1000000
